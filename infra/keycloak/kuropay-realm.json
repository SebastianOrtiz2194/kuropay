{
  "realm": "kuropay",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "kuropay-cli",
      "name": "KuroPay command line (local development)",
      "description": "Public client that lets curl trade a demo user's password for an access token. Local development only.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience: wallet-core-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "wallet-core-service",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "email": "alice@kuropay.example",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "email": "bob@kuropay.example",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    }
  ]
}
